{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "gen:code": "kubb generate",
    "gen:docs": "node scripts/build-docs.mjs",
    "gen:all": "npm run gen:code && npm run gen:docs",
    "serve:docs": "pm2 delete docs-server &&pm2 start live-server --name docs-server -- src/gen",
    "serve:stop": "pm2 delete docs-server",
    "build": "npm run gen:code && next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@types/leaflet": "^1.9.22",
    "framer-motion": "^13.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "postcss": "^8.5.26",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@kubb/plugin-fetch": "^5.0.0",
    "@kubb/plugin-react-query": "^5.0.0",
    "@kubb/plugin-redoc": "^5.0.0",
    "@kubb/plugin-ts": "^5.0.0",
    "@kubb/plugin-zod": "^5.0.0",
    "@redocly/cli": "^2.47.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "kubb": "^5.0.0",
    "live-server": "^1.2.2",
    "pm2": "^7.0.3",
    "typescript": "^5"
  }
}
